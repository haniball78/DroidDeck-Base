<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pairing_overlay_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adbpair_title_code"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/adbpair_code_hint"
        android:textColor="#FFE0E0E0"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/overlay_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:digits="0123456789"
        android:hint="@string/adbpair_code_label"
        android:imeOptions="actionDone"
        android:inputType="number"
        android:maxLength="6"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#FF9E9E9E" />

    <TextView
        android:id="@+id/overlay_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/adbpair_six_digits"
        android:textColor="#FFFFB4AB"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/overlay_enter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/adbpair_enter_code" />

        <Button
            android:id="@+id/overlay_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/common_cancel" />
    </LinearLayout>
</LinearLayout>
